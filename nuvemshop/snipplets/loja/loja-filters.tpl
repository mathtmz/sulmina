{% include 'snipplets/grid/filters-modals.tpl' %}

<aside class="sulmina-loja-filters" aria-label="Filtros de produtos">
    <div class="sulmina-loja-filter-group">
        <h4>Torra</h4>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="roast" value="clara"><span>Clara</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="roast" value="media"><span>Média</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="roast" value="escura"><span>Escura</span></label>
    </div>
    <div class="sulmina-loja-filter-group">
        <h4>Notas sensoriais</h4>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="notes" value="chocolate"><span>Chocolate</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="notes" value="caramelo"><span>Caramelo</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="notes" value="laranja"><span>Laranja</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="notes" value="floral"><span>Floral</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="notes" value="nozes"><span>Nozes</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="notes" value="mel"><span>Mel</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="notes" value="frutado"><span>Frutado</span></label>
    </div>
    <div class="sulmina-loja-filter-group">
        <h4>Produtor</h4>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="producer" value="dona-marta"><span>Dona Marta</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="producer" value="joao-lucio"><span>João Lúcio</span></label>
        <label class="sulmina-loja-filter-option"><input type="checkbox" data-loja-filter-group="producer" value="familia-andrade"><span>Família Andrade</span></label>
    </div>
    <div class="sulmina-loja-filter-group">
        <h4>Moagem</h4>
        <label class="sulmina-loja-filter-option"><input type="radio" name="sulmina-moagem" data-loja-filter-group="grind" value="grao"><span>Grão</span></label>
        <label class="sulmina-loja-filter-option"><input type="radio" name="sulmina-moagem" data-loja-filter-group="grind" value="moido"><span>Moído</span></label>
    </div>
</aside>
